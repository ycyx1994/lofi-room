<?xml version="1.0" encoding="utf-8"?>
<!--
    API 26+ 自适应图标：前景沿用原启动图标里的 "lofi" 字标（DM Serif Display 渲染，
    见 drawable-nodpi/ic_launcher_fg.png），底板取原图标底色 #111721，
    视觉上与 API 21~25 使用的 mipmap-*/ic_launcher.png 一致，不引入新设计。
    字标宽度 60/108 单位，落在 72×72 安全区内，任意遮罩（圆形/方形/水滴）都不会裁到笔画。
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_fg" />
</adaptive-icon>
