# Gradle / Android 构建产物
.gradle/
build/
app/build/
local.properties

# IDE / 系统
.idea/
*.iml
.DS_Store

# 中间音频 WAV（可由 tools/generate_music.py 复现）
build_audio/

# 第三方源码参考副本（不参与构建）
vendor/

# MiMoCode 会话状态
.mimocode/

# 构建产物 APK
*.apk

# 电视数据备份（用户照片/音乐，勿入库）
lofiroom-backup-*/
lofiroom-backup-*.zip

# release 签名密钥与口令（勿入库，换机器时手动拷贝 keystore/ 和 keystore.properties）
keystore.properties
keystore/

# 真机备份哈希树（iphone5s 全量备份，含个人数据与大量重复哈希文件，绝不能入库）
iphone5s_backup/

# 与本项目无关的本地工具（checkra1n 越狱工具，约 20MB，仅本机刷机用）
checkra1n/

# 部署缓存与产物（wrangler R2 的 state/cache、打包输出目录）
.wrangler/
dist/
wall_contact_sheet.png

# iCloud/同步盘产生的重名副本（曾把 "* 2.*" 灌进 app/build，打断 parseDebugLocalResources）
* 2.*
